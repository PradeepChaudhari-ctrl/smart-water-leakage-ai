import pandas as pd
import numpy as np


def extract_features(file_path, label):
    df = pd.read_csv(file_path)

    signal = df["Value"].values

    features = {
        "mean": np.mean(signal),
        "std": np.std(signal),
        "min": np.min(signal),
        "max": np.max(signal),
        "rms": np.sqrt(np.mean(signal**2)),
        "peak_to_peak": np.max(signal) - np.min(signal),
        "label": label
    }

    return features


if __name__ == "__main__":

    no_leak_file = "data/raw/sample/BR_NL_0.18 LPS_P1.csv"
    leak_file = "data/raw/sample/BR_OL_0.18 LPS_P1.csv"

    no_leak_features = extract_features(
        no_leak_file,
        0
    )

    leak_features = extract_features(
        leak_file,
        1
    )

    print("No Leak Features:")
    print(no_leak_features)

    print("\nLeak Features:")
    print(leak_features)
